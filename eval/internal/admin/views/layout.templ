// Package views 是管理端的 templ 视图。
//
// 用 templ 而非 html/template（HLD 技术选型表）：模板在**编译期**检查。
// 这不是形式主义——本项目开发过程中就因 html/template 踩过一次：
// paper.html 里模板变量作用域写错（{{hex $$.ID}}），直到程序启动才 panic，
// 而那是个只要编译一次就能发现的错误。
package views

// Chrome 是每个页面共用的外壳：导航条 + 启动自检告警。
type Chrome struct {
	SelfSigned  bool
	CertOK      bool
	CertMsg     string
	Warns       []string
	DomainWarns []string
	Leases      int
}

templ Layout(c Chrome) {
	<!DOCTYPE html>
	<html lang="zh-CN" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>线上民主测评系统 · 管理端</title>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/admin.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/admin.js" defer></script>
		</head>
		<body class="bg-base-200 text-base-content min-h-screen">
			<div class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-30 px-6">
				<div class="flex-1 gap-3 items-baseline">
					<a href="/admin/" class="text-lg font-bold text-seal">线上民主测评系统</a>
					<span class="text-xs opacity-60">管理端 · 仅本机可访问</span>
				</div>
				<div class="flex-none gap-2 items-center">
					if c.Leases > 0 {
						<span class="badge badge-ghost badge-sm">接入终端 { itoa(c.Leases) }</span>
					}
					<a href="/admin/" class="btn btn-ghost btn-sm">项目列表</a>
					<form method="post" action="/admin/logout">
						<button class="btn btn-ghost btn-sm">退出</button>
					</form>
				</div>
			</div>
			<main class="max-w-5xl mx-auto p-6">
				if c.SelfSigned {
					<div role="alert" class="alert alert-error mb-4">
						<div>
							<b>当前为自签名证书</b>
							<div class="text-sm">
								参评人员手机将出现安全告警，<b>禁止用于正式测评</b>。开发调试可忽略此条。
							</div>
						</div>
					</div>
				}
				if !c.CertOK {
					<div role="alert" class="alert alert-error mb-4">
						<div><b>证书自检未通过</b><div class="text-sm">{ c.CertMsg }</div></div>
					</div>
				}
				for _, w := range c.Warns {
					<div role="alert" class="alert alert-warning mb-4"><span class="text-sm">{ w }</span></div>
				}
				for _, w := range c.DomainWarns {
					<div role="alert" class="alert alert-error mb-4"><span class="text-sm">{ w }</span></div>
				}
				{ children... }
			</main>
		</body>
	</html>
}

templ StatusBadge(status string) {
	switch status {
		case "draft":
			<span class="badge badge-ghost badge-sm">草稿</span>
		case "published":
			<span class="badge badge-warning badge-sm">已发布</span>
		case "running":
			<span class="badge badge-success badge-sm">进行中</span>
		case "closed":
			<span class="badge badge-neutral badge-sm">已截止</span>
		default:
			<span class="badge badge-sm">已归档</span>
	}
}

templ Error(c Chrome, msg string) {
	@Layout(c) {
		<h1 class="text-xl font-bold mb-3">操作未完成</h1>
		<div role="alert" class="alert alert-error mb-4">
			<pre class="whitespace-pre-wrap text-sm font-sans">{ msg }</pre>
		</div>
		<div class="flex gap-2">
			<a class="btn btn-sm" href="javascript:history.back()">返回</a>
			<a class="btn btn-sm btn-primary" href="/admin/">回到项目列表</a>
		</div>
	}
}

templ Login(errMsg string) {
	<!DOCTYPE html>
	<html lang="zh-CN" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>登录 · 管理端</title>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/admin.css"/>
		</head>
		<body class="bg-base-200 min-h-screen grid place-items-center">
			<div class="card w-96 bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h1 class="card-title text-base">管理员登录</h1>
					<p class="text-xs opacity-60 -mt-1 mb-2">口令同时用于解开数据加密密钥</p>
					if errMsg != "" {
						<div role="alert" class="alert alert-error text-sm py-2">{ errMsg }</div>
					}
					<form method="post" action="/admin/login" class="flex flex-col gap-3">
						<input type="password" name="password" placeholder="管理员口令" autofocus
							class="input input-bordered w-full"/>
						<button type="submit" class="btn btn-primary w-full">登录</button>
					</form>
					<div class="text-xs opacity-60 border-t border-base-300 pt-3 mt-2">
						口令无找回机制，遗忘则数据不可访问。建议考察组两人分别知悉。
					</div>
				</div>
			</div>
		</body>
	</html>
}
