package views

import "odes/internal/store"

templ Home(c Chrome, rows []HomeRow, archives []store.ArchiveMeta) {
	@Layout(c) {
		<h1 class="text-xl font-bold">测评项目</h1>
		<p class="text-sm opacity-60 mb-4">
			单管理员模式。测评结束后请执行「导出加密归档包 + 本机安全擦除」。
		</p>
		<div class="overflow-x-auto">
			<table class="table table-zebra bg-base-100">
				<thead>
					<tr>
						<th>名称</th><th class="text-center">状态</th>
						<th class="text-center">提交 / 应参加</th>
						<th class="text-center">令牌</th><th class="text-center">截止时间</th>
					</tr>
				</thead>
				<tbody>
					if len(rows) == 0 {
						<tr>
							<td colspan="5" class="text-sm opacity-60">
								暂无项目。用 <code class="kbd kbd-sm">-seed</code> 参数启动可生成一份演示数据。
							</td>
						</tr>
					}
					for _, r := range rows {
						<tr class="hover">
							<td>
								<a class="link link-hover font-medium" href={ templ.SafeURL(projURL(r.P.ID)) }>
									{ r.P.Name }
								</a>
							</td>
							<td class="text-center">@StatusBadge(string(r.P.Status))</td>
							<td class="text-center">{ itoa(r.Submitted) } / { itoa(r.P.ExpectedCount) }</td>
							<td class="text-center">{ itoa(r.Tokens) }</td>
							<td class="text-center text-sm opacity-70">{ date(r.P.EndAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(archives) > 0 {
			<h2 class="text-base font-semibold border-l-4 border-seal pl-2 mt-8 mb-2">已归档项目</h2>
			<p class="text-sm opacity-60 mb-2">本机数据已擦除，仅保留元信息用于列表展示与核验。</p>
			<div class="overflow-x-auto">
				<table class="table bg-base-100">
					<thead>
						<tr>
							<th>名称</th><th class="text-center">应参加</th><th class="text-center">提交</th>
							<th class="text-center">核验编号</th><th class="text-center">归档时间</th>
						</tr>
					</thead>
					<tbody>
						for _, a := range archives {
							<tr>
								<td>{ a.Name }</td>
								<td class="text-center">{ itoa(a.Expected) }</td>
								<td class="text-center">{ itoa(a.Submitted) }</td>
								<td class="text-center"><code class="kbd kbd-sm">{ a.VerifyCode }</code></td>
								<td class="text-center text-sm opacity-70">{ a.ArchivedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ Project(c Chrome, v ProjectView) {
	@Layout(c) {
		<div class="flex items-center gap-3 flex-wrap">
			<h1 class="text-xl font-bold">{ v.P.Name }</h1>
			@StatusBadge(string(v.P.Status))
		</div>
		<p class="text-sm opacity-60 mb-4">
			{ date(v.P.StartAt) } 至 { date(v.P.EndAt) }　·　结果开放 { date(v.P.ResultOpenAt) }
		</p>
		<div class="stats stats-horizontal bg-base-100 border border-base-300 w-full overflow-x-auto mb-6">
			<div class="stat">
				<div class="stat-title">应参加人数</div>
				<div class="stat-value text-2xl">{ itoa(v.P.ExpectedCount) }</div>
			</div>
			<div class="stat">
				<div class="stat-title">已提交</div>
				<div class="stat-value text-2xl"
					hx-get={ projURL(v.P.ID) + "/progress" } hx-trigger="every 10s" hx-swap="innerHTML">
					{ itoa(v.Submitted) }
				</div>
			</div>
			<div class="stat">
				<div class="stat-title">令牌 / 已用</div>
				<div class="stat-value text-2xl">{ itoa(v.Tokens) } / { itoa(v.Used) }</div>
			</div>
			<div class="stat">
				<div class="stat-title">展开作答项</div>
				<div class="stat-value text-2xl">{ itoa(v.Items) }</div>
			</div>
			<div class="stat">
				<div class="stat-title">纸质补录</div>
				<div class="stat-value text-2xl">{ itoa(v.P.PaperEntryCount) }</div>
			</div>
		</div>

		<h2 class="text-base font-semibold border-l-4 border-seal pl-2 mb-2">发布前置校验</h2>
		<div class="card bg-base-100 border border-base-300 mb-6">
			<div class="card-body py-4 gap-1">
				for _, chk := range v.Checks {
					<div class="flex gap-2 items-start text-sm">
						if chk.OK {
							<span class="text-success font-bold">✓</span>
						} else {
							<span class="text-error font-bold">✗</span>
						}
						<code class="kbd kbd-sm">{ chk.Code }</code>
						<span>{ chk.Msg }</span>
					</div>
				}
			</div>
		</div>

		<h2 class="text-base font-semibold border-l-4 border-seal pl-2 mb-2">操作</h2>
		<div class="card bg-base-100 border border-base-300 mb-6">
			<div class="card-body gap-4">
				<form method="post" action={ templ.SafeURL(projURL(v.P.ID) + "/tokens") }
					class="flex gap-2 items-center flex-wrap">
					<span class="text-sm">生成令牌　数量</span>
					<input name="count" value={ itoa(v.P.ExpectedCount) } class="input input-bordered input-sm w-20"/>
					<span class="text-sm">批次</span>
					<input name="batches" value="1" class="input input-bordered input-sm w-16"/>
					<button class="btn btn-sm">生成（含 10% 备用 + 3 个试填）</button>
				</form>
				<div class="flex gap-2 flex-wrap">
					<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/print") }>打印令牌单</a>
					<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/trial") }>试填验证</a>
					<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/paper") }>纸质密封补录</a>
					<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/stats") }>查看统计</a>
				</div>
				<div class="flex gap-2 flex-wrap items-center">
					if v.P.Status == "draft" {
						<form method="post" action={ templ.SafeURL(projURL(v.P.ID) + "/status") }>
							<input type="hidden" name="to" value="published"/>
							<button class="btn btn-sm btn-primary">发布测评</button>
						</form>
					}
					if v.P.Status == "published" {
						<form method="post" action={ templ.SafeURL(projURL(v.P.ID) + "/status") }
							onsubmit="return confirm('尚未有任何提交时才能撤回。确认？')">
							<input type="hidden" name="to" value="draft"/>
							<button class="btn btn-sm btn-outline">撤回发布</button>
						</form>
					}
					if v.P.Status == "running" || v.P.Status == "published" {
						<form method="post" action={ templ.SafeURL(projURL(v.P.ID) + "/status") }
							onsubmit="return confirm('截止后将执行 WAL 截断与 VACUUM 重建（匿名化必需步骤），确认？')">
							<input type="hidden" name="to" value="closed"/>
							<button class="btn btn-sm btn-error btn-outline">手动截止</button>
						</form>
					}
					if v.P.Status == "closed" {
						<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/export") }>统计报告</a>
						<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/export?kind=csv") }>明细 CSV</a>
						<a class="btn btn-sm" href={ templ.SafeURL(projURL(v.P.ID) + "/export?kind=raw") }>原始匿名数据</a>
					}
				</div>
			</div>
		</div>

		if v.P.Status == "closed" {
			@archiveSection(v)
		}

		<h2 class="text-base font-semibold border-l-4 border-seal pl-2 mb-2">操作日志</h2>
		<div class="overflow-x-auto">
			<table class="table table-sm bg-base-100">
				<thead><tr><th>时间</th><th>动作</th><th>结果</th><th>详情</th></tr></thead>
				<tbody>
					if len(v.Logs) == 0 {
						<tr><td colspan="4" class="text-sm opacity-60">暂无</td></tr>
					}
					for _, l := range v.Logs {
						<tr>
							<td class="opacity-70 whitespace-nowrap">{ l.CreatedAt }</td>
							<td><code class="kbd kbd-sm">{ l.Action }</code></td>
							<td>{ l.Result }</td>
							<td class="text-sm">{ l.Detail }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="text-xs opacity-60 mt-2">日志不记录任何令牌值、IP 地址或作答内容。</p>
	}
}

templ archiveSection(v ProjectView) {
	<h2 class="text-base font-semibold border-l-4 border-seal pl-2 mb-2">归档与安全擦除</h2>
	<div role="alert" class="alert alert-warning mb-2 items-start">
		<div class="text-sm">
			归档 = 导出加密包 + <b>本机数据擦除</b>。擦除不可逆，请先下载归档包并确认已保存至指定介质。
		</div>
	</div>
	<div class="card bg-base-100 border border-base-300 mb-6">
		<div class="card-body gap-3">
			<div class="flex gap-2 items-center flex-wrap">
				<input id="apass" type="password" class="input input-bordered input-sm w-80"
					placeholder="归档口令（须与登录口令不同，≥10 位、含两类字符）"/>
				<button class="btn btn-sm" data-proj={ hex(v.P.ID) } onclick="odesDownloadArchive(this)">
					下载加密归档包
				</button>
			</div>
			<form method="post" action={ templ.SafeURL(projURL(v.P.ID) + "/archive") }
				class="flex gap-2 items-center flex-wrap"
				onsubmit="return confirm('本机数据将被永久擦除，无法恢复。确认继续？')">
				<input type="hidden" name="pass" id="apass2"/>
				<label class="label cursor-pointer gap-2">
					<input type="checkbox" name="saved" class="checkbox checkbox-sm"/>
					<span class="label-text text-sm">已确认加密归档包已保存至指定介质</span>
				</label>
				<input name="sha8" placeholder="包 SHA-256 前 8 位" class="input input-bordered input-sm w-44"/>
				<button class="btn btn-sm btn-error" onclick="odesCopyPass()">执行归档并擦除</button>
			</form>
			<p class="text-xs opacity-60">
				擦除覆盖数据库文件内部残留。SSD 的磨损均衡与 TRIM 可能在物理介质上保留旧页面副本，
				应用层无法控制——更高密级要求须依靠介质级措施。
			</p>
		</div>
	</div>
}
